#!ipxe

# Proxmox Open Source Products
# https://www.proxmox.com

goto ${menu} ||

:proxmox
clear proxmox_choice
clear proxmox_version
set os Proxmox
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||
clear vga_params
iseq ${os_arch} amd64 && set vga_params vga=791 video=vesafb:ywrap,mtrr ||
menu ${os} - ${os_arch}
iseq ${os_arch} amd64 && item --gap ${os} Backup Server ||
iseq ${os_arch} amd64 && item pbs-normal ${space} ${os} Backup Server 4.2-1 ||
iseq ${os_arch} amd64 && item pbs-text ${space} ${os} Backup Server 4.2-1 (Text) ||
iseq ${os_arch} amd64 && item pbs-debug ${space} ${os} Backup Server 4.2-1 (Debug) ||
iseq ${os_arch} amd64 && item --gap ${os} Datacenter Manager ||
iseq ${os_arch} amd64 && item pdm-normal ${space} ${os} Datacenter Manager 1.1-1 ||
iseq ${os_arch} amd64 && item pdm-text ${space} ${os} Datacenter Manager 1.1-1 (Text) ||
iseq ${os_arch} amd64 && item pdm-debug ${space} ${os} Datacenter Manager 1.1-1 (Debug) ||
iseq ${os_arch} amd64 && item --gap ${os} Mail Gateway ||
iseq ${os_arch} amd64 && item pmg-normal ${space} ${os} Mail Gateway 9.1-1 ||
iseq ${os_arch} amd64 && item pmg-text ${space} ${os} Mail Gateway 9.1-1 (Text) ||
iseq ${os_arch} amd64 && item pmg-debug ${space} ${os} Mail Gateway 9.1-1 (Debug) ||
iseq ${os_arch} amd64 && item --gap ${os} VE ||
iseq ${os_arch} amd64 && item pve-normal ${space} ${os} VE 9.2-1 ||
iseq ${os_arch} amd64 && item pve-text ${space} ${os} VE 9.2-1 (Text) ||
iseq ${os_arch} amd64 && item pve-debug ${space} ${os} VE 9.2-1 (Debug) ||
iseq ${os_arch} arm64 && item --gap ${os} VE ||
iseq ${os_arch} arm64 && item pve-normal ${space} ${os} VE 9.2-1 ||
iseq ${os_arch} arm64 && item pve-text ${space} ${os} VE 9.2-1 (Text) ||
iseq ${os_arch} arm64 && item pve-debug ${space} ${os} VE 9.2-1 (Debug) ||
choose proxmox_choice || goto proxmox_exit
goto ${proxmox_choice}

:pdm-normal
set params splash=silent
goto boot-pdm

:pdm-text
set params splash=silent proxtui
goto boot-pdm

:pdm-debug
set params splash=verbose proxdebug
goto boot-pdm

:pve-normal
set params splash=silent
goto boot-pve

:pve-text
set params splash=silent proxtui
goto boot-pve

:pve-debug
set params splash=verbose proxdebug
goto boot-pve

:pmg-normal
set params splash=silent
goto boot-pmg

:pmg-text
set params splash=silent proxtui
goto boot-pmg

:pmg-debug
set params splash=verbose proxdebug
goto boot-pmg

:pbs-normal
set params splash=silent
goto boot-pbs

:pbs-text
set params splash=silent proxtui
goto boot-pbs

:pbs-debug
set params splash=verbose proxdebug
goto boot-pbs

:boot-pbs
iseq ${os_arch} amd64 && set kernel_url ${live_endpoint}/asset-mirror/releases/download/4.2-1-ca8b9126/ ||
iseq ${os_arch} amd64 && set proxmox_version 4.2-1 ||
goto boot-proxmox

:boot-pmg
iseq ${os_arch} amd64 && set kernel_url ${live_endpoint}/asset-mirror/releases/download/9.1-1-fdfe5b69/ ||
iseq ${os_arch} amd64 && set proxmox_version 9.1-1 ||
goto boot-proxmox

:boot-pdm
iseq ${os_arch} amd64 && set kernel_url ${live_endpoint}/asset-mirror/releases/download/1.1-1-c313fdaf/ ||
iseq ${os_arch} amd64 && set proxmox_version 1.1-1 ||
goto boot-proxmox

:boot-pve
iseq ${os_arch} amd64 && set kernel_url ${live_endpoint}/asset-mirror/releases/download/9.2-1-4bbcc809/ ||
iseq ${os_arch} amd64 && set proxmox_version 9.2-1 ||
iseq ${os_arch} arm64 && set kernel_url ${live_endpoint}/asset-mirror/releases/download/9.2-1-ab708b5c/ ||
iseq ${os_arch} arm64 && set proxmox_version 9.2-1 ||
goto boot-proxmox

:boot-proxmox
imgfree
kernel ${kernel_url}vmlinuz ${vga_params} ramdisk_size=16777216 rw quiet ${params} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
initrd ${kernel_url}proxmox.iso /proxmox.iso
boot

:proxmox_exit
clear menu
exit 0
