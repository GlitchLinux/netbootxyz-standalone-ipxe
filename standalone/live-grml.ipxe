#!ipxe
# live-grml.ipxe - standalone netboot.xyz "live-grml" menu
# Source : https://boot.netboot.xyz/live-grml.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/live-grml.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/live-grml.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:theme_carbon
set theme_name Carbon
colour --basic 0 0
colour --basic 1 1
colour --basic 2 2
colour --basic 3 3
colour --basic 0 4
colour --basic 5 5
colour --basic 6 6
colour --basic 7 7
cpair --foreground 7 --background 0 0
cpair --foreground 7 --background 0 1
cpair --foreground 1 --background 0 2
cpair --foreground 6 --background 0 3
cpair --foreground 1 --background 0 4
cpair --foreground 7 --background 1 5
cpair --foreground 6 --background 0 6
cpair --foreground 0 --background 1 7

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu live-grml

goto ${menu} ||

:live_menu
set os Grml
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||
iseq ${os_arch} arm64 && set os_arch arm64 ||
menu ${os} - Current Arch [ ${arch} ]
item --gap ${os} Versions
iseq ${os_arch} amd64 && item 2026.09-full-amd64 ${space} ${os} 2026.09 full - amd64 ||
iseq ${os_arch} arm64 && item 2026.09-full-arm64 ${space} ${os} 2026.09 full - arm64 ||
iseq ${os_arch} amd64 && item 2026.09-small-amd64 ${space} ${os} 2026.09 small - amd64 ||
iseq ${os_arch} arm64 && item 2026.09-small-arm64 ${space} ${os} 2026.09 small - arm64 ||
choose live_version || goto live_exit
goto ${live_version}

:2026.09-full-amd64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-72b3bda8/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-72b3bda8/
goto boot

:2026.09-full-arm64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-ce330cfb/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-ce330cfb/
goto boot

:2026.09-small-amd64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-4e24e4c3/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-4e24e4c3/
goto boot

:2026.09-small-arm64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-8ba6deac/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-8ba6deac/
goto boot


:boot
imgfree
kernel ${kernel_url}vmlinuz boot=live fetch=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu live-grml - netboot.xyz standalone
item nbx_restart ${space} Back to live-grml menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the live-grml menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
