#!ipxe
# live-voyager.ipxe - standalone netboot.xyz "live-voyager" menu
# Source : https://boot.netboot.xyz/live-voyager.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/live-voyager.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/live-voyager.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu live-voyager

goto ${menu} ||

:live_menu
set os Voyager Live
menu ${os}
item --gap ${os} Versions
item bullseye ${space} ${os} bullseye
item focal ${space} ${os} focal
item jammy ${space} ${os} jammy
choose live_version || goto live_exit
goto ${live_version}

:bullseye
set squash_url ${live_endpoint}/debian-squash/releases/download/bullseye-f7a68a8e/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/bullseye-f7a68a8e/
imgfree
kernel ${kernel_url}vmlinuz boot=live fetch=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:focal
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/focal-594b12a7/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/focal-594b12a7/
imgfree
kernel ${kernel_url}vmlinuz ip=dhcp boot=casper netboot=url url=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:jammy
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/jammy-0d0397c9/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/jammy-0d0397c9/
imgfree
kernel ${kernel_url}vmlinuz ip=dhcp boot=casper netboot=url url=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot


:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu live-voyager - netboot.xyz standalone
item nbx_restart ${space} Back to live-voyager menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the live-voyager menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
