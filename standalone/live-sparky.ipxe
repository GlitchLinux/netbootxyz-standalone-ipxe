#!ipxe
# live-sparky.ipxe - standalone netboot.xyz "live-sparky" menu
# Source : https://boot.netboot.xyz/live-sparky.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/live-sparky.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/live-sparky.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu live-sparky

goto ${menu} ||

:live_menu
set os SparkyLinux Live
menu ${os}
item --gap ${os} Versions
item stable ${space} ${os} Stable
item rolling ${space} ${os} Rolling
choose live_version || goto live_exit
menu ${os} ${live_version}
item --gap ${os} Flavors
goto ${live_version}

:stable
item sparky-stable-gui ${space} Sparky stable Xfce
item sparky-stable-lxqt ${space} Sparky stable Lxqt
item sparky-stable-mingui ${space} Sparky stable Xfce-Min
goto flavor_select

:rolling
item sparky-rolling-gui ${space} Sparky rolling Xfce
item sparky-rolling-lxqt ${space} Sparky rolling Lxqt
item sparky-rolling-mingui ${space} Sparky rolling Xfce-Min
goto flavor_select

:flavor_select
choose flavor || goto live_menu
echo ${cls}
goto ${flavor} ||

:sparky-rolling-gui
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.03-314f0a50/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.03-314f0a50/
goto boot
:sparky-rolling-lxqt
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.03-1a7f6c6a/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.03-1a7f6c6a/
goto boot
:sparky-rolling-mingui
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.03-8a7a4cf8/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.03-8a7a4cf8/
goto boot
:sparky-stable-gui
set squash_url ${live_endpoint}/debian-squash/releases/download/8.3.1-28fbf253/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/8.3.1-28fbf253/
goto boot
:sparky-stable-lxqt
set squash_url ${live_endpoint}/debian-squash/releases/download/8.3-16df4761/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/8.3-16df4761/
goto boot
:sparky-stable-mingui
set squash_url ${live_endpoint}/debian-squash/releases/download/8.3-d8df60d4/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/8.3-d8df60d4/
goto boot

:boot
imgfree
kernel ${kernel_url}vmlinuz boot=live fetch=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu live-sparky - netboot.xyz standalone
item nbx_restart ${space} Back to live-sparky menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the live-sparky menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
