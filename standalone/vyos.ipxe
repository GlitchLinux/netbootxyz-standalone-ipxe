#!ipxe
# vyos.ipxe - standalone netboot.xyz "vyos" menu
# Source : https://boot.netboot.xyz/vyos.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/vyos.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/vyos.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu vyos

# VyOS
# https://vyos.io

goto ${menu}

:vyos
set os VyOS
menu ${os} Installers
item --gap Official Releases
item rolling ${space} ${os} 1.5 rolling
choose vyos_version || goto vyos_exit
goto vyos_boot

:vyos_boot
imgfree
set url ${live_endpoint}/debian-squash/releases/download/2026.11.20-0016-rolling-fea15975/
kernel ${url}vmlinuz boot=live components hostname=vyos username=live nopersistence noautologin union=overlay console=tty0 net.ifnames=0 biosdevname=0 fetch=${url}filesystem.squashfs initrd=initrd.magic ${cmdline}
initrd ${url}initrd

boot
goto vyos_exit

:vyos_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu vyos - netboot.xyz standalone
item nbx_restart ${space} Back to vyos menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the vyos menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
