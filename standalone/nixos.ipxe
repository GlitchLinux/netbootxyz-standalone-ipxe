#!ipxe
# nixos.ipxe - standalone netboot.xyz "nixos" menu
# Source : https://boot.netboot.xyz/nixos.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/nixos.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/nixos.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:theme_carbon
set theme_name Carbon
colour --basic 0 0
colour --basic 1 1
colour --basic 2 2
colour --basic 3 3
colour --basic 0 4
colour --basic 5 5
colour --basic 6 6
colour --basic 7 7
cpair --foreground 7 --background 0 0
cpair --foreground 7 --background 0 1
cpair --foreground 1 --background 0 2
cpair --foreground 6 --background 0 3
cpair --foreground 1 --background 0 4
cpair --foreground 7 --background 1 5
cpair --foreground 6 --background 0 6
cpair --foreground 0 --background 1 7

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
# (none)

########## original netboot.xyz menu ##########
:nbx_start
set menu nixos

# NixOS
# https://nixos.org/

set os NixOS
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch x86_64 ||
iseq ${os_arch} arm64 && set os_arch aarch64 ||
menu ${os} - ${os_arch}
item --gap Official Releases
item nixos-unstable ${space} ${os} nixos-unstable
item nixos-26.05 ${space} ${os} nixos-26.05
item nixos-25.11 ${space} ${os} nixos-25.11
item nixos-25.05 ${space} ${os} nixos-25.05
item nixos-24.11 ${space} ${os} nixos-24.11
item nixos-24.05 ${space} ${os} nixos-24.05
item nixos-23.11 ${space} ${os} nixos-23.11
item nixos-23.05 ${space} ${os} nixos-23.05
item nixos-22.11 ${space} ${os} nixos-22.11
item nixos-22.05 ${space} ${os} nixos-22.05
item nixos-21.11 ${space} ${os} nixos-21.11
item nixos-21.05 ${space} ${os} nixos-21.05
item nixos-20.09 ${space} ${os} nixos-20.09
choose version || goto nixos_exit

imgfree
chain https://github.com/nix-community/nixos-images/releases/download/${version}/netboot-${os_arch}-linux.ipxe
goto nixos_exit

:nixos_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu nixos - netboot.xyz standalone
item nbx_restart ${space} Back to nixos menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the nixos menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
