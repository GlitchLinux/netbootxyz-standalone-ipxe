#!ipxe
# live-ubuntu.ipxe - standalone netboot.xyz "live-ubuntu" menu
# Source : https://boot.netboot.xyz/live-ubuntu.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/live-ubuntu.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/live-ubuntu.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu live-ubuntu

goto ${menu} ||

:live_menu
set os Ubuntu Live
menu ${os}
item --gap ${os} Versions
item jammy ${space} ${os} 22.04
item focal ${space} ${os} 20.04
choose live_version || goto live_exit
menu ${os} ${live_version}
item --gap ${os} Flavors
goto ${live_version}

:jammy
item ubuntu-22.04-Budgie-squash ${space} Ubuntu 22.04 Budgie
item ubuntu-22.04-KDE-squash ${space} Ubuntu 22.04 Kde
item ubuntu-22.04-LXQT-squash ${space} Ubuntu 22.04 Lxqt
item ubuntu-22.04-MATE-squash ${space} Ubuntu 22.04 Mate
item ubuntu-22.04-XFCE-squash ${space} Ubuntu 22.04 Xfce
item ubuntu-22.04-default-squash ${space} Ubuntu 22.04 Gnome
item ubuntu-22.04-kylin-squash ${space} Ubuntu 22.04 Kylin
goto flavor_select

:focal
item ubuntu-20.04-Budgie-squash ${space} Ubuntu 20.04 Budgie
item ubuntu-20.04-KDE-squash ${space} Ubuntu 20.04 Kde
item ubuntu-20.04-LXQT-squash ${space} Ubuntu 20.04 Lxqt
item ubuntu-20.04-MATE-squash ${space} Ubuntu 20.04 Mate
item ubuntu-20.04-XFCE-squash ${space} Ubuntu 20.04 Xfce
item ubuntu-20.04-default-squash ${space} Ubuntu 20.04 Gnome
item ubuntu-20.04-kylin-squash ${space} Ubuntu 20.04 Kylin
goto flavor_select

:flavor_select
choose flavor || goto live_menu
echo ${cls}
goto ${flavor} ||

:ubuntu-20.04-Budgie-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-67d49334/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-67d49334/
goto 20.04-boot
:ubuntu-20.04-KDE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-b70db93f/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-b70db93f/
goto 20.04-boot
:ubuntu-20.04-LXQT-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.5-d8b36f04/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.5-d8b36f04/
goto 20.04-boot
:ubuntu-20.04-MATE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-6bb01f2e/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-6bb01f2e/
goto 20.04-boot
:ubuntu-20.04-XFCE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-09e46288/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-09e46288/
goto 20.04-boot
:ubuntu-20.04-default-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-d37bfb5f/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-d37bfb5f/
goto 20.04-boot
:ubuntu-20.04-kylin-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-3bddfc62/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/20.04.6-3bddfc62/
goto 20.04-boot
:ubuntu-22.04-Budgie-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-6741cfe6/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-6741cfe6/
goto 22.04-boot
:ubuntu-22.04-KDE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-15476290/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-15476290/
goto 22.04-boot
:ubuntu-22.04-LXQT-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-898ace36/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-898ace36/
goto 22.04-boot
:ubuntu-22.04-MATE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-c6e8816b/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-c6e8816b/
goto 22.04-boot
:ubuntu-22.04-XFCE-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-c2dcb4c5/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-c2dcb4c5/
goto 22.04-boot
:ubuntu-22.04-default-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-206d4f50/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-206d4f50/
goto 22.04-boot
:ubuntu-22.04-kylin-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-ea089ee1/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/22.04.5-ea089ee1/
goto 22.04-boot
:ubuntu-24.04-default-squash
set squash_url ${live_endpoint}/ubuntu-squash/releases/download/26.10-88542178/filesystem.squashfs
set kernel_url ${live_endpoint}/ubuntu-squash/releases/download/26.10-88542178/
goto 24.04-boot

:20.04-boot
:22.04-boot
imgfree
kernel ${kernel_url}vmlinuz ip=dhcp boot=casper netboot=url url=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
:24.04-boot
echo live-ubuntu: menu target '24.04-boot' does not exist upstream.
prompt Press any key...
goto nbx_exit

########## standalone exit menu ##########
:nbx_exit
menu live-ubuntu - netboot.xyz standalone
item nbx_restart ${space} Back to live-ubuntu menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the live-ubuntu menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
