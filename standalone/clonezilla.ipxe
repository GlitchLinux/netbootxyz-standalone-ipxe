#!ipxe
# clonezilla.ipxe - standalone netboot.xyz "clonezilla" menu
# Source : https://boot.netboot.xyz/clonezilla.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/clonezilla.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/clonezilla.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:theme_carbon
set theme_name Carbon
colour --basic 0 0
colour --basic 1 1
colour --basic 2 2
colour --basic 3 3
colour --basic 0 4
colour --basic 5 5
colour --basic 6 6
colour --basic 7 7
cpair --foreground 7 --background 0 0
cpair --foreground 7 --background 0 1
cpair --foreground 1 --background 0 2
cpair --foreground 6 --background 0 3
cpair --foreground 1 --background 0 4
cpair --foreground 7 --background 1 5
cpair --foreground 6 --background 0 6
cpair --foreground 0 --background 1 7

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu clonezilla

goto ${menu} ||

:live_menu
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||
iseq ${os_arch} i386 && set os_arch i686 ||
set os Clonezilla
menu ${os}
item --gap ${os} Versions
item debian ${space} ${os} Debian Based
iseq ${os_arch} amd64 && item ubuntu ${space} ${os} Ubuntu Based ||
choose live_version || goto live_exit
menu ${os} ${live_version} - ${os_arch}
item --gap ${os} Flavors
goto ${live_version}

:debian
iseq ${os_arch} amd64 && item /debian-squash/releases/download/3.3.3-37-0790c10c/ ${space} Clonezilla 3.3.3-37 Stable ||
iseq ${os_arch} amd64 && item /debian-squash/releases/download/3.3.4-23-7f56e939/ ${space} Clonezilla 3.3.4-23 Testing ||
choose path || goto live_menu
goto clonezilla-boot

:ubuntu
iseq ${os_arch} amd64 && item /ubuntu-squash/releases/download/20261126-stonking-e29c1458/ ${space} Clonezilla 20261126-Stonking Stable ||
iseq ${os_arch} amd64 && item /ubuntu-squash/releases/download/20261126-tenacious-2558197c/ ${space} Clonezilla 20261126-Tenacious Testing ||
choose path || goto live_menu
goto clonezilla-boot

:clonezilla-boot
imgfree
set url ${live_endpoint}${path}
kernel ${url}vmlinuz boot=live username=user union=overlay config components noswap edd=on nomodeset ocs_live_run="ocs-live-general" ocs_live_batch=no net.ifnames=0 nosplash noprompt fetch=${url}filesystem.squashfs initrd=initrd.magic ${cmdline}
initrd ${url}initrd
boot

:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu clonezilla - netboot.xyz standalone
item nbx_restart ${space} Back to clonezilla menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the clonezilla menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
