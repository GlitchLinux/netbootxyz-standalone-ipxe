#!ipxe
# centos.ipxe - standalone netboot.xyz "centos" menu
# Source : https://boot.netboot.xyz/centos.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/centos.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/centos.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:theme_carbon
set theme_name Carbon
colour --basic 0 0
colour --basic 1 1
colour --basic 2 2
colour --basic 3 3
colour --basic 0 4
colour --basic 5 5
colour --basic 6 6
colour --basic 7 7
cpair --foreground 7 --background 0 0
cpair --foreground 7 --background 0 1
cpair --foreground 1 --background 0 2
cpair --foreground 6 --background 0 3
cpair --foreground 1 --background 0 4
cpair --foreground 7 --background 1 5
cpair --foreground 6 --background 0 6
cpair --foreground 0 --background 1 7

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${centos_mirror} || set centos_mirror https://mirror.stream.centos.org
isset ${centos_base_dir} || set centos_base_dir

########## original netboot.xyz menu ##########
:nbx_start
set menu centos

# CentOS Stream
# http://www.centos.org

isset ${dhcp-server} && set ipparam ip=dhcp || set ipparam ip=${ip}::${gateway}:${netmask}:::none nameserver=${dns}
set ipparam BOOTIF=${netX/mac} ${ipparam}

goto ${menu} ||

:centos
clear osversion
set os CentOS Stream
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch x86_64 ||
iseq ${os_arch} arm64 && set os_arch aarch64 ||
menu ${os} - ${os_arch}
item 10-stream ${space} ${os} 10.0 Stream
item 9-stream ${space} ${os} 9.0 Stream
isset ${osversion} || choose osversion || goto linux_menu
echo ${cls}
set dir ${centos_base_dir}/${osversion}/BaseOS/${os_arch}/os ||
set repo ${centos_mirror}/${dir}
goto boottype

:boottype
set ova ${os} ${osversion}
menu ${os} ${os_arch} boot type
item graphical ${ova} graphical installer
item text ${ova} text based installer
item rescue ${ova} rescue
item kickstart ${ova} set kickstart url [ ${ks_url} ]
isset ${bt} || choose bt || goto centos
echo ${cls}
iseq ${bt} text && goto text ||
iseq ${bt} rescue && goto rescue ||
iseq ${bt} kickstart && goto kickstart ||
iseq ${bt} kickstart_device && goto kickstart_device ||
goto bootos_images

:graphical
set install_mode inst.graphical ||
goto bootos_images

:text
set install_mode inst.text ||
goto bootos_images

:rescue
set params inst.rescue ||
goto bootos_images

:kickstart
echo -n Specify kickstart URL for ${os} ${osversion}: && read ks_url
set params inst.ks=${ks_url} ||
clear bt
goto boottype

:bootos_images
imgfree
kernel ${centos_mirror}/${dir}/images/pxeboot/vmlinuz inst.repo=${repo} ${install_mode} ${params} ${ipparam} initrd=initrd.magic ${cmdline}
initrd ${centos_mirror}/${dir}/images/pxeboot/initrd.img
echo
echo MD5sums:
md5sum vmlinuz initrd.img
boot
goto linux_menu

:linux_menu
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
:kickstart_device
echo centos: menu target 'kickstart_device' does not exist upstream.
prompt Press any key...
goto nbx_exit

########## standalone exit menu ##########
:nbx_exit
menu centos - netboot.xyz standalone
item nbx_restart ${space} Back to centos menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the centos menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
