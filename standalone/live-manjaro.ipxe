#!ipxe
# live-manjaro.ipxe - standalone netboot.xyz "live-manjaro" menu
# Source : https://boot.netboot.xyz/live-manjaro.ipxe (scraped 2026-11-27)
# Built  : make-standalone.py - bootstrap + boot.cfg globals inlined,
#          exits redirected to a local exit menu.
# Embed  : make bin/ipxe.iso EMBED=/path/live-manjaro.ipxe
#          make bin-x86_64-efi/ipxe.efi EMBED=/path/live-manjaro.ipxe
# Original netboot.xyz code: https://github.com/netbootxyz/netboot.xyz (Apache-2.0)

########## standalone bootstrap ##########
:nbx_init
isset ${arch} && goto nbx_arch_done ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:nbx_arch_done
set space:hex 20:20
set space ${space:string}
iseq ${cls} serial && goto nbx_cls_done ||
set cls:hex 1b:5b:4a
set cls ${cls:string}
:nbx_cls_done

:nbx_net
isset ${ip} && goto nbx_net_done ||
echo Configuring network (DHCP)...
dhcp && goto nbx_net_done ||
echo DHCP failed - press any key to retry, or wait 10s for the iPXE shell.
prompt --timeout 10000 && goto nbx_net ||
echo Type "exit" in the shell to retry DHCP.
shell
goto nbx_net
:nbx_net_done
ntp 0.pool.ntp.org ||

########## netboot.xyz globals used by this menu (from boot.cfg) ##########
isset ${live_endpoint} || set live_endpoint https://github.com/netbootxyz

########## original netboot.xyz menu ##########
:nbx_start
set menu live-manjaro

:live_menu
set os Manjaro
menu ${os} Live
set ipparam BOOTIF=${netX/mac} ip=dhcp net.ifnames=0
item --gap ${os} Live versions
item current ${space} ${os} Current Stable (21.x)
choose menu || goto live_exit
goto ${menu}

:current
menu ${os} Live Current
item --gap ${os} Versions
item current-gnome ${space} ${os} current gnome
item current-kde ${space} ${os} current kde
item current-xfce ${space} ${os} current xfce
choose version || goto live_menu
goto ${version}

:current-gnome
set fetch_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-917f9a0a/
set kernel_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-917f9a0a/
goto boot
:current-kde
set fetch_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-df3b24fa/
set kernel_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-df3b24fa/
goto boot
:current-xfce
set fetch_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-93c4b57e/
set kernel_url ${live_endpoint}/manjaro-squash/releases/download/26.0.4-260327-linux618-93c4b57e/
goto boot

:boot
imgfree
kernel ${kernel_url}vmlinuz misobasedir=manjaro ${ipparam} miso_http_srv=${fetch_url} nouveau.modeset=1 i915.modeset=1 radeon.modeset=1 driver=free tz=UTC lang=en_US keytable=us initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
goto nbx_exit

########## standalone stubs for labels missing upstream ##########
# (none)

########## standalone exit menu ##########
:nbx_exit
menu live-manjaro - netboot.xyz standalone
item nbx_restart ${space} Back to live-manjaro menu
item nbx_shell ${space} iPXE shell
item nbx_reboot ${space} Reboot
item nbx_poweroff ${space} Power off
item nbx_quit ${space} Exit iPXE (continue firmware boot order)
choose --default nbx_restart nbx_choice || goto nbx_start
goto ${nbx_choice}
:nbx_restart
goto nbx_start
:nbx_shell
echo Type "exit" to return to the live-manjaro menu.
shell
goto nbx_start
:nbx_reboot
reboot
goto nbx_start
:nbx_poweroff
poweroff
goto nbx_start
:nbx_quit
exit 1
