#!ipxe

goto ${menu} ||

:live_menu
set os Debian Live
menu ${os}
item --gap ${os} Versions
item trixie ${space} ${os} 13 (trixie)
choose live_version || goto live_exit
menu ${os} ${live_version}
item --gap ${os} Flavors
goto ${live_version}

:trixie
item debian-13-cinnamon-squash ${space} Debian 13.7.0 Cinnamon
item debian-13-default-squash ${space} Debian 13.7.0 Core
item debian-13-gnome-squash ${space} Debian 13.7.0 Gnome
item debian-13-kde-squash ${space} Debian 13.7.0 Kde
item debian-13-lxde-squash ${space} Debian 13.7.0 Lxde
item debian-13-lxqt-squash ${space} Debian 13.7.0 Lxqt
item debian-13-mate-squash ${space} Debian 13.7.0 Mate
item debian-13-xfce-squash ${space} Debian 13.7.0 Xfce
goto flavor_select

:flavor_select
choose flavor || goto live_menu
echo ${cls}
goto ${flavor} ||

:debian-13-cinnamon-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-b92f504b/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-default-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-96693faa/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-gnome-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-fb71121c/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-kde-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-e4e00843/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-lxde-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-f94e83c4/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-lxqt-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-7b24d038/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-mate-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-ca54f57a/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot
:debian-13-xfce-squash
set squash_url ${live_endpoint}/debian-squash/releases/download/13.7.0-3761931e/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-core-13/releases/download/13.7.0-f21f0a6b/
goto boot

:boot
imgfree
kernel ${kernel_url}vmlinuz boot=live fetch=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
exit 0
