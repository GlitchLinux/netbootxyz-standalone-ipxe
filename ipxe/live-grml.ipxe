#!ipxe

goto ${menu} ||

:live_menu
set os Grml
set os_arch ${arch}
iseq ${os_arch} x86_64 && set os_arch amd64 ||
iseq ${os_arch} arm64 && set os_arch arm64 ||
menu ${os} - Current Arch [ ${arch} ]
item --gap ${os} Versions
iseq ${os_arch} amd64 && item 2026.09-full-amd64 ${space} ${os} 2026.09 full - amd64 ||
iseq ${os_arch} arm64 && item 2026.09-full-arm64 ${space} ${os} 2026.09 full - arm64 ||
iseq ${os_arch} amd64 && item 2026.09-small-amd64 ${space} ${os} 2026.09 small - amd64 ||
iseq ${os_arch} arm64 && item 2026.09-small-arm64 ${space} ${os} 2026.09 small - arm64 ||
choose live_version || goto live_exit
goto ${live_version}

:2026.09-full-amd64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-72b3bda8/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-72b3bda8/
goto boot

:2026.09-full-arm64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-ce330cfb/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-ce330cfb/
goto boot

:2026.09-small-amd64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-4e24e4c3/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-4e24e4c3/
goto boot

:2026.09-small-arm64
set squash_url ${live_endpoint}/debian-squash/releases/download/2026.09-8ba6deac/filesystem.squashfs
set kernel_url ${live_endpoint}/debian-squash/releases/download/2026.09-8ba6deac/
goto boot


:boot
imgfree
kernel ${kernel_url}vmlinuz boot=live fetch=${squash_url} initrd=initrd.magic ${cmdline}
initrd ${kernel_url}initrd
boot

:live_exit
clear menu
exit 0
